{
  "manifest_version": 1,
  "name": "BetterMV",
  "slug": "ncm-better-mv",
  "version": "0.7.0",
  "author": "XIAOMING6680",
  "author_link": "https://github.com/xiaoming6680",
  "description": "为正在播放的歌实时生成一支 3D MV：场景用它的封面搭，镜头按歌曲结构剪辑，风格按曲风自动选。",
  "betterncm_version": ">=1.3.4",
  "ncm-version-req": ">=3.0.0",
  "ncm3-compatible": true,
  "type": "extension",
  "require_restart": true,
  "preview": "preview.jpg",
  "injects": {
    "Main": [
      {
        "file": "bettermv.js"
      }
    ]
  }
}
